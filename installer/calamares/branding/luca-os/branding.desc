# Luca OS Calamares Branding Descriptor
---
componentName:  luca-os
welcomeStyleCalamares: false
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 960px,600px
windowPlacement: center

strings:
    productName:         Luca OS
    version:             1.0 (Desktop Edition)
    shortVersion:        1.0
    versionedName:       Luca OS 1.0
    shortVersionedName:  Luca OS 1.0
    bootloaderEntryName: Luca OS
    productUrl:          https://github.com/luca-os/luca-os
    supportUrl:          https://github.com/luca-os/luca-os/discussions
    knownIssuesUrl:      https://github.com/luca-os/luca-os/issues
    releaseNotesUrl:     https://github.com/luca-os/luca-os/blob/main/CHANGELOG.md

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "welcome.png"

style:
   SidebarBackground:    "#080C17"
   SidebarTextColor:     "#F8FAFC"
   SidebarTextSelect:    "#00F2FE"
   SidebarTextHighlight: "#3B82F6"
