#!/usr/bin/env bash
# ==============================================================================
# Luca OS — Google Play Device Certification Helper (luca-play-id)
# Extracts the Android Google Services Framework (GSF) ID from Waydroid
# and provides instructions / clipboard copy for Google certification.
# ==============================================================================

set -euo pipefail

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${CYAN}======================================================================${NC}"
echo -e "${CYAN}             ⚡ Luca OS — Google Play Device Certification             ${NC}"
echo -e "${CYAN}======================================================================${NC}"

# Ensure Waydroid container is running
if ! systemctl is-active --quiet waydroid-container; then
    echo "Starting waydroid-container service..."
    sudo systemctl start waydroid-container
    sleep 3
fi

# Ensure waydroid session is active to access GSF database
SESSION_STARTED=0
if ! waydroid status 2>/dev/null | grep -q "RUNNING"; then
    echo "Starting temporary Android session to read GSF database..."
    waydroid session start >/dev/null 2>&1 &
    SESSION_STARTED=1
    sleep 6
fi

echo "Querying Android Google Services Framework database..."

SQL_CMD="select value from main where name = 'android_id';"
GSF_QUERY='ANDROID_RUNTIME_ROOT=/apex/com.android.runtime ANDROID_DATA=/data ANDROID_TZDATA_ROOT=/apex/com.android.tzdata ANDROID_I18N_ROOT=/apex/com.android.i18n sqlite3 /data/data/com.google.android.gsf/databases/gservices.db "select * from main where name = '\''android_id'\'';"'

RAW_ID=$(sudo waydroid shell -- sh -c "$GSF_QUERY" 2>/dev/null | grep "android_id|" || true)

if [ -z "$RAW_ID" ]; then
    echo -e "${YELLOW}[Notice]${NC} Google Services Framework ID not yet generated by Android."
    echo "        Please launch Google Play Store once inside Luca OS to generate the ID,"
    echo "        then run 'luca-play-id' again."
    if [ "$SESSION_STARTED" -eq 1 ]; then
        waydroid session stop >/dev/null 2>&1 || true
    fi
    exit 0
fi

CLEAN_ID=$(echo "$RAW_ID" | cut -d'|' -f2 | tr -d '\r\n ')

echo ""
echo -e "${GREEN}======================================================================${NC}"
echo -e "${GREEN}  Your Luca OS Android GSF ID:${NC} ${CYAN}${CLEAN_ID}${NC}"
echo -e "${GREEN}======================================================================${NC}"
echo ""

# Copy to clipboard if wl-copy or xclip available
if command -v wl-copy >/dev/null 2>&1; then
    echo -n "$CLEAN_ID" | wl-copy
    echo -e "✓ Copied GSF ID to Wayland clipboard automatically!"
elif command -v xclip >/dev/null 2>&1; then
    echo -n "$CLEAN_ID" | xclip -selection clipboard
    echo -e "✓ Copied GSF ID to X11 clipboard automatically!"
fi

echo ""
echo "Next Steps:"
echo "1. Visit the Google Device Registration Portal:"
echo -e "   ${CYAN}https://www.google.com/android/uncertified/${NC}"
echo "2. Sign in with your Google account and paste the GSF ID above."
echo "3. Click 'Register'."
echo "4. Restart your Waydroid session:"
echo -e "   ${CYAN}waydroid session stop && sudo systemctl restart waydroid-container${NC}"
echo "5. Wait 10-15 minutes, then sign in to Google Play Store!"
echo ""
