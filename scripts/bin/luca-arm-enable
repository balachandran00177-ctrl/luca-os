#!/usr/bin/env bash
# ==============================================================================
# Luca OS — ARM Translation Layer Installer (luca-arm-enable)
# Auto-detects Intel or AMD CPU architectures and installs libhoudini or libndk
# to enable ARM64 / ARMv7 Android APKs and 3D games to execute on x86_64 PCs.
# ==============================================================================

set -euo pipefail

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${CYAN}======================================================================${NC}"
echo -e "${CYAN}             ⚡ Luca OS — ARM App & Game Compatibility Engine          ${NC}"
echo -e "${CYAN}======================================================================${NC}"

# Detect CPU Vendor
CPU_VENDOR=$(grep -m1 "vendor_id" /proc/cpuinfo 2>/dev/null | awk '{print $3}' || echo "Unknown")
echo "Detected CPU Vendor: $CPU_VENDOR"

WORKDIR="$HOME/.local/share/waydroid_script"

# Install dependencies if missing
if ! command -v git >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
    echo "Installing required build prerequisites (git, python3, venv, lzip)..."
    sudo apt-get update
    sudo apt-get install -y git python3 python3-pip python3-venv lzip curl
fi

# Clone or update waydroid_script
if [ ! -d "$WORKDIR" ]; then
    echo "Cloning translation toolchain to $WORKDIR..."
    git clone https://github.com/casualsnek/waydroid_script "$WORKDIR"
else
    echo "Updating existing translation toolchain in $WORKDIR..."
    git -C "$WORKDIR" pull || true
fi

cd "$WORKDIR"

# Virtual environment setup
if [ ! -d "venv" ]; then
    python3 -m venv venv
fi
source venv/bin/activate
pip install -U pip -r requirements.txt

# Selective translation based on CPU
if [ "$CPU_VENDOR" = "AuthenticAMD" ]; then
    echo -e "${CYAN}AMD Processor detected — Installing libndk ARM translation...${NC}"
    sudo venv/bin/python3 main.py install libndk
else
    echo -e "${CYAN}Intel/x86_64 Processor detected — Installing libhoudini ARM translation...${NC}"
    sudo venv/bin/python3 main.py install libhoudini
fi

echo ""
echo "Restarting Waydroid container service to apply translation layer..."
waydroid session stop >/dev/null 2>&1 || true
sudo systemctl restart waydroid-container

echo ""
echo -e "${GREEN}======================================================================${NC}"
echo -e "${GREEN}  ✓ ARM translation layer successfully installed and activated!       ${NC}"
echo -e "${GREEN}======================================================================${NC}"
echo "You can now install and run ARM-native APKs and 3D games seamlessly."
echo ""
