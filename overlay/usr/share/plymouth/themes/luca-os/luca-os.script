# Luca OS Plymouth Boot Animation Script
# Smooth breathing logo and progress feedback

Window.SetBackgroundTopColor(0.04, 0.05, 0.08);
Window.SetBackgroundBottomColor(0.02, 0.03, 0.05);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 20);

# Progress indicator animation
progress = 0;
fun refresh_callback() {
  progress += 0.04;
  # Smooth sine wave opacity pulsation (0.65 to 1.0)
  opacity = 0.72 + 0.28 * Math.Sin(progress);
  logo.sprite.SetOpacity(opacity);
}

Plymouth.SetRefreshFunction(refresh_callback);

# Message handling during boot/shutdown
fun message_callback(text) {
  # Optional debug/status text output
}
Plymouth.SetMessageFunction(message_callback);
